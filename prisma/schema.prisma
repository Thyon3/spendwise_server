// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  password         String
  firstName        String?
  lastName         String?
  phoneNumber      String?
  profileImageUrl  String?
  twoFactorEnabled Boolean            @default(false)
  twoFactorSecret  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  Category         Category[]
  Expense          Expense[]
  Income           Income[]
  RecurringExpense RecurringExpense[]
  Tag              Tag[]
  Budget           Budget[]
  Settings         Settings?
  Notification     Notification[]
  SavingsGoal      SavingsGoal[]
  PaymentMethod    PaymentMethod[]
  Session          Session[]
  Debt             Debt[]
  Investment       Investment[]
  BudgetTemplate   BudgetTemplate[]
  FinancialGoal    FinancialGoal[]
  RecurringIncome  RecurringIncome[]
  Subscription     Subscription[]
}

model Category {
  id               String             @id @default(cuid())
  name             String
  color            String
  type             CategoryType       @default(EXPENSE)
  userId           String
  user             User               @relation(fields: [userId], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  Expense          Expense[]
  Income           Income[]
  RecurringExpense RecurringExpense[]
  Budget           Budget[]
  RecurringIncome  RecurringIncome[]

  @@unique([userId, name])
}

model Tag {
  id        String    @id @default(cuid())
  name      String
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[] @relation("ExpenseTags")

  @@unique([userId, name])
}

model RecurringExpense {
  id             String    @id @default(cuid())
  amount         Float
  currency       String
  description    String?
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  recurrenceType String // NONE, DAILY, WEEKLY, MONTHLY, YEARLY
  interval       Int       @default(1)
  startDate      DateTime
  endDate        DateTime?
  lastGenerated  DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  expenses       Expense[]
}

model Expense {
  id                 String            @id @default(cuid())
  amount             Float
  currency           String
  description        String?
  date               DateTime
  location           String?
  notes              String?
  isFavorite         Boolean           @default(false)
  isReconciled       Boolean           @default(false)
  reconciledAt       DateTime?
  userId             String
  user               User              @relation(fields: [userId], references: [id])
  categoryId         String
  category           Category          @relation(fields: [categoryId], references: [id])
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])
  paymentMethodId    String?
  paymentMethod      PaymentMethod?    @relation(fields: [paymentMethodId], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  tags               Tag[]             @relation("ExpenseTags")
  attachments        Attachment[]
  sharedExpenses     SharedExpense[]

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, isFavorite])
  @@index([userId, isReconciled])
}

model Budget {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  name        String
  amountLimit Float
  currency    String
  periodType  String // WEEKLY, MONTHLY, CUSTOM_RANGE
  periodStart DateTime?
  periodEnd   DateTime?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  rollover    Boolean   @default(false)
  alertAt50   Boolean   @default(true)
  alertAt75   Boolean   @default(true)
  alertAt90   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([userId, categoryId])
}

enum CategoryType {
  EXPENSE
  INCOME
}

model Income {
  id          String   @id @default(cuid())
  amount      Float
  currency    String
  description String?
  date        DateTime
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, categoryId])
}

model Settings {
  id                  String  @id @default(cuid())
  userId              String  @unique
  user                User    @relation(fields: [userId], references: [id])
  preferredCurrency   String  @default("USD")
  theme               String  @default("SYSTEM") // LIGHT, DARK, SYSTEM
  notificationsEnabled Boolean @default(true)
  biometricEnabled    Boolean @default(false)
  language            String  @default("en")
  dateFormat          String  @default("MM/DD/YYYY")
  firstDayOfWeek      Int     @default(0) // 0 = Sunday, 1 = Monday
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Notification {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  title             String
  message           String
  type              String    // BUDGET_ALERT, RECURRING_REMINDER, GOAL_ACHIEVED, etc.
  isRead            Boolean   @default(false)
  relatedEntityId   String?
  relatedEntityType String?
  createdAt         DateTime  @default(now())
  readAt            DateTime?

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Attachment {
  id          String   @id @default(cuid())
  expenseId   String
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  fileSize    Int
  mimeType    String
  createdAt   DateTime @default(now())

  @@index([expenseId])
}

model SavingsGoal {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  name          String
  targetAmount  Float
  currentAmount Float    @default(0)
  currency      String
  deadline      DateTime?
  description   String?
  isCompleted   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model PaymentMethod {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  type        String   // CASH, CREDIT_CARD, DEBIT_CARD, BANK_TRANSFER, DIGITAL_WALLET
  lastFourDigits String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expenses    Expense[]

  @@index([userId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  action      String   // CREATE, UPDATE, DELETE
  entityType  String   // EXPENSE, INCOME, BUDGET, etc.
  entityId    String
  oldValue    String?  // JSON string
  newValue    String?  // JSON string
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  deviceInfo   String?
  ipAddress    String?
  userAgent    String?
  isActive     Boolean  @default(true)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  @@index([userId, isActive])
  @@index([token])
}

model SharedExpense {
  id          String   @id @default(cuid())
  expenseId   String
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  sharedWith  String   // Email or user ID
  splitType   String   // EQUAL, PERCENTAGE, EXACT_AMOUNT
  splitValue  Float    // Percentage or exact amount
  isPaid      Boolean  @default(false)
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expenseId])
}

model Debt {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  name            String
  type            String   // LOAN, CREDIT_CARD, MORTGAGE, PERSONAL
  totalAmount     Float
  remainingAmount Float
  interestRate    Float?
  currency        String
  startDate       DateTime
  dueDate         DateTime?
  minimumPayment  Float?
  isPaidOff       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  payments        DebtPayment[]

  @@index([userId])
}

model DebtPayment {
  id              String   @id @default(cuid())
  debtId          String
  debt            Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount          Float
  principalAmount Float
  interestAmount  Float
  paymentDate     DateTime
  notes           String?
  createdAt       DateTime @default(now())

  @@index([debtId])
}

model Investment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  name            String
  type            String   // STOCKS, BONDS, MUTUAL_FUNDS, CRYPTO, REAL_ESTATE, OTHER
  symbol          String?
  quantity        Float
  purchasePrice   Float
  currentPrice    Float
  currency        String
  purchaseDate    DateTime
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model BudgetTemplate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  description String?
  categories  String   // JSON array of category allocations
  totalAmount Float
  currency    String
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model CurrencyRate {
  id           String   @id @default(cuid())
  baseCurrency String
  targetCurrency String
  rate         Float
  lastUpdated  DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([baseCurrency, targetCurrency])
  @@index([baseCurrency])
}

model FinancialGoal {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  name            String
  type            String   // RETIREMENT, EMERGENCY_FUND, VACATION, EDUCATION, OTHER
  targetAmount    Float
  currentAmount   Float    @default(0)
  currency        String
  targetDate      DateTime?
  priority        Int      @default(1) // 1-5, 5 being highest
  description     String?
  isCompleted     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model RecurringIncome {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  amount         Float
  currency       String
  description    String?
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  recurrenceType String    // DAILY, WEEKLY, MONTHLY, YEARLY
  interval       Int       @default(1)
  startDate      DateTime
  endDate        DateTime?
  lastGenerated  DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
}

model Subscription {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  name            String
  provider        String
  amount          Float
  currency        String
  billingCycle    String   // MONTHLY, YEARLY, WEEKLY
  startDate       DateTime
  nextBillingDate DateTime
  endDate         DateTime?
  isActive        Boolean  @default(true)
  categoryId      String?
  reminderDays    Int      @default(3)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([userId, nextBillingDate])
}
